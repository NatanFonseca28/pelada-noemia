# Imagem de produção da API: só dependências de runtime, usuário sem privilégios, sem código de teste.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
RUN useradd --system --uid 10001 --home-dir /app --shell /usr/sbin/nologin app

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app
COPY scripts ./scripts
RUN mkdir -p /app/media && chown app:app /app/media

USER app
EXPOSE 8000
# Migrations com o usuário dono do schema; a API roda com o usuário de privilégio mínimo (ver docker-compose.prod.yml).
# --proxy-headers: o IP real do cliente vem do Caddy (a porta da API não é publicada, só o Caddy a alcança).
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips='*' --no-server-header"]
