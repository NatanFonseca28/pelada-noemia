# Produção — copie para .env.prod (NUNCA versione o .env.prod) e preencha.
# Gere cada segredo com:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# Domínio público (o Caddy emite o certificado HTTPS automaticamente)
DOMAIN=pelada.seudominio.com.br
ACME_EMAIL=seu-email@exemplo.com
HTTP_PORT=80
HTTPS_PORT=443

# Banco: dono do schema (migrations e backup)
POSTGRES_DB=pelada
POSTGRES_USER=pelada_owner
POSTGRES_PASSWORD=GERE-UM-SEGREDO

# Banco: usuário da aplicação (só lê/escreve dados)
APP_DB_USER=pelada_app
APP_DB_PASSWORD=GERE-OUTRO-SEGREDO

# Assinatura dos tokens (mínimo 32 caracteres; a API não sobe com valor fraco)
JWT_SECRET=GERE-UM-SEGREDO-LONGO

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
MAX_PHOTO_MB=3
